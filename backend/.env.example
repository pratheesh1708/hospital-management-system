PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=hospital_db
MYSQL_USER=root
MYSQL_PASSWORD=
DB_DRIVER=auto

# JWT Configuration
JWT_SECRET=super_secure_hospital_jwt_secret_production_ready_key_2026!
