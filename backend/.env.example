COOKIE_SECURE=false

# Google OAuth Configuration
GOOGLE_CLIENT_ID=mock-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=mock-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/oauth/google/callback

# SMTP Email Configuration
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=mock_hospital_mailer@ethereal.email
SMTP_PASSWORD=mock_smtp_password
EMAIL_FROM="St. Jude Hospital System <no-reply@stjudehospital.org>"

# Redis / Queue Configuration
